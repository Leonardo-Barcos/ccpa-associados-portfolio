# ---------------------------------------------------------------
# CCPA - Área de Associados | Variáveis de ambiente
# Copie para .env e preencha. NUNCA versione o .env.
# ---------------------------------------------------------------

APP_NAME="Clube de Criativos do Pará"
APP_ENV=development                 # development | production
BASE_URL=http://localhost:8000      # URL pública (usada nos links do e-mail)

# Banco de dados
# dev:  sqlite+pysqlite:///./ccpa.db
# prod: a string de conexão do PostgreSQL, como o provedor entrega. Use a
#       versão COM POOLER quando existir (na Neon, a que tem "-pooler" no host):
#       em serverless cada instância abre conexão própria e o limite estoura.
DATABASE_URL=sqlite+pysqlite:///./ccpa.db

# Criar as tabelas quando a aplicação sobe. Deixe true em desenvolvimento.
# Em produção rode `python scripts/init_db.py` uma vez e coloque false — cada
# cold start refaria o trabalho num banco que já tem as tabelas.
AUTO_CREATE_TABLES=true

# ------------------------- Resend ------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
MAIL_FROM="CCPA <associados@ccpara.com.br>"
MAIL_REPLY_TO=criativosdopara@gmail.com
MAIL_BCC_ADMIN=criativosdopara@gmail.com     # cópia interna de cada adesão

# ---------------------- Pagamentos -----------------------------
# Somente cartão de crédito, com assinatura recorrente na Asaas.
# mock  -> checkout falso interno (desenvolvimento e homologação)
# asaas -> gateway Asaas de verdade (obrigatório em produção)
PAYMENT_PROVIDER=mock

# Asaas (quando PAYMENT_PROVIDER=asaas)
# A chave fica em Configurações > Integrações > Chave de API, no painel da Asaas.
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3      # sandbox: https://api-sandbox.asaas.com/v3

# Token que a Asaas envia no cabeçalho asaas-access-token de cada webhook.
# Você define esse valor ao cadastrar o webhook no painel da Asaas apontando
# para https://SEU_DOMINIO/webhooks/pagamento. Sem ele, qualquer pessoa
# consegue marcar uma associação como paga.
ASAAS_WEBHOOK_TOKEN=

# Pix Automático: o associado autoriza uma vez no app do banco e a mensalidade
# é debitada sozinha. Deixe false até a Asaas liberar na conta (exige conta PJ,
# CNPJ ativo há 6 meses e cadastro sem pendências). Com false, a opção nem
# aparece no formulário. Depois de ligar, rode de novo scripts/setup_webhook.py
# para o webhook passar a receber os eventos da autorização.
PIX_AUTOMATIC_ENABLED=false

# ------------------- Painel de gestão --------------------------
# Assina o cookie de sessão do painel (/painel). Quem tiver este valor
# consegue entrar como qualquer usuário do painel: trate como senha.
# Em desenvolvimento pode ficar vazio. Em produção é obrigatório, com pelo
# menos 32 caracteres. Para gerar um:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
